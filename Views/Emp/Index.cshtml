@model IEnumerable<Employee.Models.Emp_Data>

<h1>Employee Details</h1>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Employee ID</th>
			<th>Employee Name</th>
			<th>Salary</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var emp in Model)
		{
			if (emp == null)
			{
				<tr><td colspan="4">Null employee object found!</td></tr>
				continue;
			}
			<tr>
				<td>@emp.Emp_ID</td>
				<td>@emp.Emp_Name</td>
				<td>@emp.Salary</td>
				<td>
					<form asp-controller="Emp" asp-action="Details" asp-route-id="@emp.Emp_ID" method="get" class="btn me-2">
						<button type="submit" class="btn btn-primary border-0">Details</button>
					</form>
					<form asp-controller="Emp" asp-action="Edit" asp-route-id="@emp.Emp_ID" method="get" class="btn me-2">
						<button type="submit" class="btn btn-primary border-0">Edit</button>
					</form>
					<form asp-controller="Emp" asp-action="Delete" asp-route-id="@emp.Emp_ID" method="get" class="btn me-2">
						<button type="submit" class="btn btn-primary border-0">Delete</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>
<button class="btn btn-info" onclick="location.href='@Url.Action("Create","Emp")'">Add Employee</button>

